# Copy to .env and edit. Real environment variables override these.
# The .env file is git-ignored. NEVER commit real credentials.

# ---- Mode selection --------------------------------------------------------
# llm:     mock | ollama
# backend: windows (this computer's event logs; the product) | windows-replay
#          (recorded event XML) | fixture (demo incidents) | wazuh (optional integration)
SOCI_LLM=mock
SOCI_BACKEND=fixture

# ---- Web server ------------------------------------------------------------
SOCI_HOST=127.0.0.1
SOCI_PORT=8000

# ---- Agent bounds ----------------------------------------------------------
SOCI_MAX_STEPS=12
SOCI_MAX_EVIDENCE=150
SOCI_MAX_RESULTS_PER_TOOL=25
SOCI_MAX_WINDOW_MINUTES=60
SOCI_MAX_LOOKBACK_HOURS=24
SOCI_MAX_REPAIR_ATTEMPTS=2
# Wall-clock budget for evidence gathering (seconds); the final report is still requested.
SOCI_MAX_INVESTIGATION_SECONDS=900
# Concurrency / history / shutdown
SOCI_MAX_CONCURRENT_RUNS=2
SOCI_MAX_RETAINED_RUNS=100
SOCI_SHUTDOWN_GRACE_SECONDS=10
# Where reports and the run journal are written. Default: ./reports in a source
# checkout, otherwise %LOCALAPPDATA%\soc-investigator\reports (never site-packages).
# SOCI_REPORTS_DIR=C:\SOC\reports
# Stored prompt/response copies are clipped only beyond this size (clipping is recorded).
SOCI_AUDIT_MAX_CHARS=200000

# ---- Ollama (only used when SOCI_LLM=ollama) -------------------------------
SOCI_OLLAMA_URL=http://127.0.0.1:11434
SOCI_OLLAMA_MODEL=qwen2.5:7b-instruct
SOCI_OLLAMA_TEMPERATURE=0.0
SOCI_OLLAMA_NUM_CTX=16384
SOCI_OLLAMA_TIMEOUT=180
SOCI_OLLAMA_KEEP_ALIVE=10m
SOCI_OLLAMA_SEED=42
# Output bound (tokens). The prompt budget reserves this for the answer.
SOCI_OLLAMA_NUM_PREDICT=2048
# Conservative chars-per-token used to keep prompts inside NUM_CTX. Capped at 2.0:
# encoded/hex telemetry measured 1.7-2.5 chars/token with the Qwen2.5 tokenizer.
# Long encoded blobs are replaced in prompts by bounded descriptions. NUM_CTX
# below 8192 leaves too little room for a useful prompt at this ratio.
SOCI_PROMPT_CHARS_PER_TOKEN=2.0
# Send the response JSON schema as Ollama `format` (Ollama >= 0.5); false -> format=json.
SOCI_OLLAMA_STRUCTURED_OUTPUT=true

# ---- Windows event logs (SOCI_BACKEND=windows / windows-replay) ------------
# Recorded event XML folder for windows-replay (default: packaged synthetic samples).
# SOCI_WINDOWS_REPLAY_DIR=C:\rw-evidence-20261001-101500
SOCI_WINDOWS_SIGNAL_LOOKBACK_HOURS=24
# Newest events read per source when scanning for signals (a hit is disclosed).
SOCI_WINDOWS_SCAN_LIMIT=2000
# "Recent" window used by capability discovery (limited = no such events recently).
SOCI_WINDOWS_DISCOVERY_DAYS=7

# ---- Wazuh (optional integration; only used when SOCI_BACKEND=wazuh) --------
# Wazuh indexer = OpenSearch API (default port 9200). READ-ONLY use.
SOCI_WAZUH_INDEXER_URL=https://YOUR-WAZUH-HOST:9200
SOCI_WAZUH_INDEXER_USER=readonly-analyst
SOCI_WAZUH_INDEXER_PASSWORD=
# The alerts index holds rule matches. To query surrounding (non-alert) Sysmon
# events you must enable Wazuh archives (logall_json) and point this at that index.
SOCI_WAZUH_ALERTS_INDEX=wazuh-alerts-*
SOCI_WAZUH_EVENTS_INDEX=wazuh-alerts-*
SOCI_WAZUH_MIN_ALERT_LEVEL=10
SOCI_WAZUH_ALERT_LOOKBACK_HOURS=24
# TLS: set to true and provide a CA bundle in production. false only for a lab.
SOCI_WAZUH_VERIFY_TLS=true
# SOCI_WAZUH_CA_BUNDLE=C:\path\to\root-ca.pem

# Optional: Wazuh server API (default port 55000) for richer host context.
# SOCI_WAZUH_API_URL=https://YOUR-WAZUH-HOST:55000
# SOCI_WAZUH_API_USER=wazuh
# SOCI_WAZUH_API_PASSWORD=

# Dashboard admission and memory bounds. Saved JSON files are not auto-deleted.
SOCI_MAX_CONCURRENT_RUNS=2
SOCI_MAX_RETAINED_RUNS=100
